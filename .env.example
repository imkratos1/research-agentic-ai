# copy this file to .env and fill in your own values (.env is never committed)
GEMINI_API_KEY=

# exact Gemini model IDs; Flash-Lite models have the highest free daily limit
MAIN_MODEL=gemini-3.5-flash-lite
LITE_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-2

# used when MAIN_MODEL is overloaded (error 503), out of daily quota, or slower than GEMINI_TIMEOUT seconds
BACKUP_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=60

# optional: shared with Wikipedia and OpenAlex in the User-Agent so they can contact you
CONTACT_EMAIL=

# quick, standard or deep
DEPTH=standard
