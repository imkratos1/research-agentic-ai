// system architecture of the DeepResearch Agent, drawn with Graphviz (dot)
digraph architecture {
  graph [fontname="Arial", rankdir=LR, newrank=true, compound=true, nodesep=0.25, ranksep=0.7, pad=0.35,
         label=<<b>DeepResearch Agent - system architecture</b>>, labelloc=t, fontsize=20, fontcolor="#1A237E"]
  node  [fontname="Arial", shape=box, style="rounded,filled", fontsize=12, penwidth=1.2, margin="0.16,0.07", width=1.9,
         color="#3949AB", fillcolor="#E8EAF6", fontcolor="#263238"]
  edge  [fontname="Arial", fontsize=10, color="#607D8B", fontcolor="#455A64", arrowsize=0.7, penwidth=1.1]

  subgraph cluster_entry {
    label=<<b>Entry points</b>>; fontsize=13; fontcolor="#37474F"; style="rounded,dashed"; color="#90A4AE"; margin=12
    ui   [label=<<b>Streamlit UI</b><br/><font point-size="10" color="#5C6BC0">app.py</font>>]
    cli  [label=<<b>Command line</b><br/><font point-size="10" color="#5C6BC0">main.py</font>>]
    eval [label=<<b>Evaluation</b><br/><font point-size="10" color="#5C6BC0">evaluate.py</font>>]
  }

  pipeline [label=<<b>Pipeline</b><br/><font point-size="10">runs the 6 phases,<br/>keeps the research state,<br/>streams progress</font><br/><font point-size="10" color="#5C6BC0">pipeline.py, models.py</font>>,
            fillcolor="#C5CAE9", color="#1A237E", penwidth=1.6]

  subgraph cluster_agents {
    label=<<b>Agent roles</b><br/><font point-size="10">same Gemini model, different prompt and tools</font>>; fontsize=13; fontcolor="#1A237E"
    style="rounded,filled"; fillcolor="#F5F6FC"; color="#9FA8DA"; margin=14; labelloc=b
    planner    [label=<<b>1. Planner</b><br/><font point-size="10">research questions</font><br/><font point-size="10" color="#5C6BC0">planner.py</font>>]
    researcher [label=<<b>2. Researcher</b><br/><font point-size="10">ReAct tool loop</font><br/><font point-size="10" color="#5C6BC0">researcher.py</font>>, penwidth=2.2]
    extractor  [label=<<b>3. Extractor</b><br/><font point-size="10">claims as JSON</font><br/><font point-size="10" color="#5C6BC0">extractor.py</font>>]
    verifier   [label=<<b>4. Verifier</b><br/><font point-size="10">cross-validation loop,<br/>re-searches weak claims</font><br/><font point-size="10" color="#5C6BC0">verifier.py</font>>, penwidth=2.2]
    writer     [label=<<b>5. Writer + Critic</b><br/><font point-size="10">cited sections</font><br/><font point-size="10" color="#5C6BC0">writer.py</font>>]
    planner -> researcher -> extractor -> verifier -> writer [color="#3949AB", penwidth=1.5]
  }

  subgraph cluster_tools {
    label=<<b>Tools and helpers</b>>; fontsize=13; fontcolor="#00695C"; style="rounded,filled"; fillcolor="#F1F8F7"; color="#80CBC4"; margin=14
    node [color="#00897B", fillcolor="#E0F2F1"]
    search [label=<<b>search.py</b><br/><font point-size="10">web, news, Wikipedia, papers</font>>]
    fetch  [label=<<b>fetch.py</b><br/><font point-size="10">HTML and PDF to text</font>>]
    cred   [label=<<b>credibility.py</b><br/><font point-size="10">trust tier per website</font>>]
    gem    [label=<<b>gemini.py</b><br/><font point-size="10">used by every agent role:<br/>retry, JSON output, embeddings</font>>]
    cache  [label=<<b>cache.py</b><br/><font point-size="10">saves every response</font>>]
  }

  subgraph cluster_output {
    label=<<b>Report output</b>>; fontsize=13; fontcolor="#4A148C"; style="rounded,filled"; fillcolor="#F8F3FA"; color="#CE93D8"; margin=14
    node [color="#8E24AA", fillcolor="#F3E5F5"]
    pdf    [label=<<b>pdf_report.py</b><br/><font point-size="10">ReportLab PDF</font>>]
    charts [label=<<b>charts.py</b><br/><font point-size="10">matplotlib charts</font>>]
  }

  subgraph cluster_external {
    label=<<b>External services</b>>; fontsize=13; fontcolor="#E65100"; style="rounded,filled"; fillcolor="#FFFAF3"; color="#FFCC80"; margin=14
    node [color="#FB8C00", fillcolor="#FFF3E0", width=2.3]
    gemini_api [label=<<b>Gemini API</b><br/><font point-size="10">gemini-3.5-flash-lite (main)<br/>gemini-3.1-flash-lite (bulk, backup)<br/>gemini-embedding-2</font>>]
    ddg        [label=<<b>DuckDuckGo</b><br/><font point-size="10">via the ddgs library</font>>]
    wiki       [label=<<b>Wikipedia API</b>>]
    openalex   [label=<<b>OpenAlex API</b><br/><font point-size="10">scholarly works</font>>]
    websites   [label=<<b>Websites and PDFs</b>>]
  }

  subgraph cluster_storage {
    label=<<b>Files on disk</b>>; fontsize=13; fontcolor="#37474F"; style="rounded,filled"; fillcolor="#F7F9FA"; color="#B0BEC5"; margin=14
    node [shape=cylinder, style=filled, color="#546E7A", fillcolor="#ECEFF1", width=2.3]
    trust     [label=<<b>trusted_sources.yaml</b><br/><font point-size="10">editable trust tiers</font>>]
    cache_dir [label=<<b>data/cache/</b><br/><font point-size="10">saved API and web responses</font>>]
    run_dir   [label=<<b>runs/&lt;id&gt;/</b><br/><font point-size="10">state.json, report.pdf</font>>]
  }

  ui -> pipeline
  cli -> pipeline
  eval -> pipeline
  pipeline -> extractor [lhead=cluster_agents]

  researcher -> search
  researcher -> fetch
  researcher -> cred
  verifier -> search [style=dashed, color="#E65100"]
  extractor -> gem [ltail=cluster_agents]
  writer -> pdf

  pdf -> charts
  gem -> gemini_api
  search -> ddg
  search -> wiki
  search -> openalex
  fetch -> websites

  search -> cache [style=dotted, arrowhead=none]
  fetch -> cache [style=dotted, arrowhead=none]
  gem -> cache [style=dotted, arrowhead=none]
  cache -> cache_dir
  cred -> trust [style=dashed]
  pdf -> run_dir [style=dashed]
}
